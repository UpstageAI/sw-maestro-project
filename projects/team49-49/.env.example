ICH_DATABASE_URL=sqlite:///./data/ideation_context_hub.sqlite3

# Default: auto-select Upstage when this key exists.
UPSTAGE_API_KEY=

# Optional provider override: auto, upstage, claude, codex_oauth, local.
# ICH_LLM_PROVIDER=auto

# Optional Claude support.
# ANTHROPIC_API_KEY=

# Optional Codex/OpenAI OAuth bearer token support.
# ICH_CODEX_OAUTH_TOKEN=

# Optional source auto-fetch tokens. Leave blank to use pasted/exported content.
# ICH_NOTION_TOKEN=
# ICH_GITHUB_TOKEN=
# ICH_SLACK_TOKEN=
# ICH_LINEAR_TOKEN=
# ICH_MCP_SERVER_URL=
# ICH_MCP_ACCESS_TOKEN=

# Optional LangGraph Platform remote graph support.
# LANGGRAPH_DEPLOYMENT_URL=
# LANGSMITH_API_KEY=
# LANGGRAPH_QA_ASSISTANT_ID=
# LANGGRAPH_REVIEW_ASSISTANT_ID=
