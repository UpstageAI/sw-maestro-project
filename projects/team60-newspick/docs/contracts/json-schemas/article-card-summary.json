{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newspick.local/schemas/article-card-summary.json",
  "title": "ArticleCardSummary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "source",
    "publishedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
