# Upstage Solar API
# https://console.upstage.ai 에서 API 키 발급 (16만원 free credit)
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_DEFAULT_MODEL=solar-pro2

# Mock LLM 라우팅 — 키 없거나 아래 변수가 mock 이면 오프라인 더미 응답으로 자동 폴백
# REVIEW_OPS_LLM=mock  # 오프라인 데모/CI 시 강제 mock 모드

# 노드별 모델 (default solar-pro2 — 한국어 강점, 16만원 credit 으로 충분)
MODEL_CLASSIFIER=solar-pro2
MODEL_DRAFTER=solar-pro2
MODEL_PATTERN=solar-pro2
MODEL_CHECKLIST=solar-pro2
MODEL_DIFF_HINT=solar-pro2

# 경로
DB_PATH=data/review_ops.db
STORE_DUMP_PATH=data/store_dump.json

# Drafter few-shot에 주입할 톤 샘플 최대 개수
TONE_SAMPLES_LIMIT=3
